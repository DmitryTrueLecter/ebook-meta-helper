  "info": {
    "title": "ebook-meta-helper API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ai-calls/{call_id}": {
      "get": {
        "description": "Full AI call including prompts, raw response, and provenance.",
        "operationId": "get_ai_call_detail_api_ai_calls__call_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "title": "Call Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AICallDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ai Call Detail",
        "tags": [
          "ai-calls"
        ]
      }
    },
    "/api/ai-config/active": {
      "get": {
        "description": "The currently active AI config version; 404 when none is active.",
        "operationId": "get_active_ai_config_api_ai_config_active_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIConfigVersionView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Active Ai Config",
        "tags": [
          "ai-config"
        ]
      }
    },
    "/api/ai-config/versions": {
      "get": {
        "description": "All AI config versions \u2014 highest version number first.",
        "operationId": "list_ai_config_versions_api_ai_config_versions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AIConfigVersionView"
                  },
                  "title": "Response List Ai Config Versions Api Ai Config Versions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Ai Config Versions",
        "tags": [
          "ai-config"
        ]
      }
    },
    "/api/directories": {
      "get": {
