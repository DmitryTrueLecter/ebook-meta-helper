# ebook-meta-helper environment template
# Copy to `.env` and fill in. Do not commit `.env`.

# Host paths
HOST_NEW_BOOKS_DIR=
HOST_BOOKS_READY_DIR=
HOST_DEBUG_DIR=./debug_logs

# API
API_PORT=8000          # local only — prod uses Traefik on 443

# Web domain
WEB_DOMAIN=            # prod only, e.g. books.example.com

# Database
DB_NAME=ebook_meta
DB_USER=ebook
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306
DB_HOST=mariadb        # override only when pointing at an external DB
DATABASE_URL="mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# AI provider
AI_PROVIDER="openai"   # openai | dummy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Image tag
IMAGE_TAG=latest       # prod only — pin to sha-abc1234 for controlled deploys

# HTTP Basic Auth
BASIC_AUTH_USERS=      # prod only — bcrypt htpasswd; escape $ as $$ — see environments.md

# Misc
FILENAME_TEMPLATE="{Authors} - {SeriesName}" #{SeriesNumber} - {Title} [{Language}]
DEBUG=0
