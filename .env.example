# =============================================================================
# ebook-meta-helper environment template
# Copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Host paths (REQUIRED — fail-fast: docker compose up errors if unset)
# -----------------------------------------------------------------------------
# Linux (prod):   absolute paths on the host, e.g. /mnt/nas/books/inbox
# Windows (dev):  absolute paths with either backslashes or forward slashes,
#                 e.g. D:\Books\inbox  or  D:/Books/inbox
#                 The drive must be enabled in Docker Desktop > Settings >
#                 Resources > File sharing.
HOST_NEW_BOOKS_DIR=
HOST_BOOKS_READY_DIR=
HOST_DEBUG_DIR=./debug_logs

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# PROD: not used — Traefik terminates TLS on 443 and forwards to container :8000.
# LOCAL (docker-compose.local.yml): publishes api on 127.0.0.1:${API_PORT}.
API_PORT=8000

# -----------------------------------------------------------------------------
# Web domain (PROD ONLY)
# -----------------------------------------------------------------------------
# Public hostname Traefik routes to this app, e.g. books.example.com.
# DNS A/AAAA record must already point at the Traefik host.
# Leave empty for local — the local override does not read this.
WEB_DOMAIN=

# -----------------------------------------------------------------------------
# Database (REQUIRED — change defaults before any deploy)
# -----------------------------------------------------------------------------
DB_NAME=ebook_meta
DB_USER=ebook
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306
# DB_HOST is set by compose (always `mariadb` inside the stack). Override
# only if you point the api at an external database.
DB_HOST=mariadb
DATABASE_URL="mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
AI_PROVIDER="openai" # openai | dummy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Container-internal paths
# -----------------------------------------------------------------------------
# NOT configured here. NEW_BOOKS_DIR / BOOKS_READY_DIR / DEBUG_DIR are fixed to
# the volume mount targets and are set in docker-compose.yml `environment:`,
# co-located with the mounts so they can never drift. You only set the HOST_*
# paths above. (`environment:` in compose overrides anything in this .env.)

# -----------------------------------------------------------------------------
# Image tag (PROD ONLY — ignored locally, local uses docker-compose.local.yml build:)
# -----------------------------------------------------------------------------
# Pin to a specific GHCR digest or short SHA for controlled deploys.
# Defaults to `latest` if unset.  Example: IMAGE_TAG=sha-abc1234
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# HTTP Basic Auth (PROD ONLY — enforced by the Traefik middleware, not the app)
# -----------------------------------------------------------------------------
# The app has NO built-in authentication. Traefik's basicauth middleware is the
# ONLY gate. This variable MUST be set before exposing the service publicly.
#
# Generate the htpasswd entry (bcrypt, cost 10):
#   htpasswd -nbB <username> <password>
#   — or without apache2-utils:
#   python3 -c "import bcrypt,base64,os; p=b'<password>'; h=bcrypt.hashpw(p,bcrypt.gensalt(10)).decode(); print(f'<username>:{h}')"
#
# ESCAPING RULE: every '$' in the hash MUST be doubled to '$$' when written
# into this .env file, because Docker Compose interpolates '$' as a variable
# reference when reading .env values.
#
# Example (what htpasswd produces):
#   admin:$2y$10$abcdefghijklmnopqrstuuVWXYZ0123456789abcdefghijklmno
# What you write in .env:
#   BASIC_AUTH_USERS=admin:$$2y$$10$$abcdefghijklmnopqrstuuVWXYZ0123456789abcdefghijklmno
#
# Multiple users: separate with comma (apply the same $→$$ escaping to each).
BASIC_AUTH_USERS=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
FILENAME_TEMPLATE="{Authors} - {SeriesName}" #{SeriesNumber} - {Title} [{Language}]
DEBUG=0
